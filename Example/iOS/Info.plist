<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- The languages of Resources/<language>.lproj, which the Localization plugin compares. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>de</string>
    </array>
    <key>CFBundleName</key>
    <string>DebugDrawerExample</string>
    <key>CFBundleIdentifier</key>
    <string>com.debugdrawer.example.ios</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>NSCameraUsageDescription</key>
    <string>The example asks for the camera to show the Permissions plugin's Request button.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>The example asks for the microphone to show the Permissions plugin's Request button.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>The example asks for the photo library to show the Permissions plugin's Request button.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>The example asks for your location to show the Permissions plugin's Request button.</string>
    <key>NSContactsUsageDescription</key>
    <string>The example asks for contacts to show the Permissions plugin's Request button.</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.debugdrawer.example.refresh</string>
        <string>com.debugdrawer.example.cleanup</string>
        <!-- The sidecar session's continued processing task (DebugDrawerBackgroundKeeper), which
             needs no UIBackgroundModes entry. -->
        <string>com.debugdrawer.example.ios.DebugDrawerSession.*</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <!-- Read by App Info's Build section; a CI script would write its own build number here. -->
    <key>DebugDrawerCIBuildNumber</key>
    <string>local</string>
    <!-- The app's own scheme: the Deep Link Tester lists it as a preset, and the app routes its URLs. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>DebugDrawer Example</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>debugdrawer-example-ios</string>
            </array>
        </dict>
    </array>
    <!-- Remote viewing (ExampleRemoteServer, and the Mac's Remote window): the local network
         prompt's reason, and the Bonjour service the server advertises and the viewer browses for. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Lets a Mac on your network show this debug build's logs and requests.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_debugdrawer._tcp</string>
    </array>
</dict>
</plist>
