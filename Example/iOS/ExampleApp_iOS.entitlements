<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lets registerForRemoteNotifications() get a device token, which the simulator gives an app
         that declares it; the Notifications plugin shows it. -->
    <key>aps-environment</key>
    <string>development</string>
    <!-- The identity Xcode gives a simulator build and rules_apple doesn't: without it the data
         protection keychain refuses the app (errSecMissingEntitlement), so the Keychain plugin and
         Reset App State would have no keychain. The simulator checks neither the team prefix nor a
         profile. -->
    <key>application-identifier</key>
    <string>FAKETEAMID.com.debugdrawer.example.ios</string>
    <key>keychain-access-groups</key>
    <array>
        <string>FAKETEAMID.com.debugdrawer.example.ios</string>
        <!-- A second group, so the Keychain plugin's access group filter has a choice
             (ExampleKeychain adds a password to it). -->
        <string>FAKETEAMID.com.debugdrawer.example.shared</string>
    </array>
    <!-- The app group File Browser lists the container of, which the simulator gives the app
         without a profile. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.debugdrawer.example</string>
    </array>
</dict>
</plist>
