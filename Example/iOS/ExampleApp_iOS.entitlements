<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lets registerForRemoteNotifications() get a device token, which the simulator gives an app
         that declares it; the Notifications plugin shows it. -->
    <key>aps-environment</key>
    <string>development</string>
</dict>
</plist>
