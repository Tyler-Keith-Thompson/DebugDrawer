<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The group the host serves its sidecar in, beside Example/Sidecar; the simulator gives it
         without a profile. The Mac app is built without a group: `just run sidecar macOS` signs it
         with the team-prefixed one (Example/SidecarStore). -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.debugdrawer.example</string>
    </array>
    <!-- Lets the app register for remote notifications, so the push registration capability has a
         device token to show the sidecar; the simulator gives a sandbox token without a profile. -->
    <key>aps-environment</key>
    <string>development</string>
</dict>
</plist>
