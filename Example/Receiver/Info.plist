<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleName</key>
    <string>DebugDrawerReceiverExample</string>
    <key>CFBundleIdentifier</key>
    <string>com.debugdrawer.example.receiver</string>
    <key>CFBundleVersion</key>
