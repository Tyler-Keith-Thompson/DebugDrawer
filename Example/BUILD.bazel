    "//Sources/DebugDrawer",
    "//Sources/DebugDrawerAccessibilityPlugin",
    "//Sources/DebugDrawerAppInfoPlugin",
    "//Sources/DebugDrawerConsolePlugin",
    "//Sources/DebugDrawerDiskIOPlugin",
    "//Sources/DebugDrawerEnergyPlugin",
    "//Sources/DebugDrawerFileBrowserPlugin",
    "//Sources/DebugDrawerKeychainPlugin",
    "//Sources/DebugDrawerNetworkPlugin",
    "//Sources/DebugDrawerPerformancePlugin",
    "//Sources/DebugDrawerScreenshotPlugin",
    "//Sources/DebugDrawerUserDefaultsPlugin",
    "//Sources/DebugDrawerViewInspectorPlugin",
    "//Sources/DebugDrawerLocationPlugin",
    "//Sources/DebugDrawerLoadedLibrariesPlugin",
    "//Sources/DebugDrawerDeepLinkPlugin",
    "//Sources/DebugDrawerCookiesPlugin",
    "//Sources/DebugDrawerLaunchTimePlugin",
    "//Sources/DebugDrawerTweaksPlugin",
    "//Sources/DebugDrawerFeatureFlagsPlugin",
    "//Sources/DebugDrawerCrashReportsPlugin",
    "//Sources/DebugDrawerHangDetectorPlugin",
    "//Sources/DebugDrawerLeakDetectorPlugin",
    "//Sources/DebugDrawerMetricKitPlugin",
    "//Sources/DebugDrawerPermissionsPlugin",
    "//Sources/DebugDrawerNotificationsPlugin",
    "//Sources/DebugDrawerBackgroundTasksPlugin",
    "//Sources/DebugDrawerAnalyticsPlugin",
    "//Sources/DebugDrawerDatabaseBrowserPlugin",
    "//Sources/DebugDrawerLocalizationPlugin",
    "//Sources/DebugDrawerScreenRecordingPlugin",
    "//Sources/DebugDrawerDesignOverlayPlugin",
    "//Sources/DebugDrawerColorVisionPlugin",
    "//Sources/DebugDrawerAppStateResetPlugin",
]

# ── Shared by the examples ───────────────────────────────────────────
# The test bench: actions that give each plugin something to show (a failing request, a WebSocket,
# a line at every log level, main-thread file I/O, defaults, keychain and cookie writes, a leak, a
# hang, a crash), as a SwiftUI list, a Mac menu and plain data for UIKit. Every example links it
# rather than keeping a copy.

swift_library(
    name = "ExampleTestBench",
    srcs = glob(["TestBench/*.swift"]),
    module_name = "ExampleTestBench",
    deps = [
        "//Sources/DebugDrawer",
        "//Sources/DebugDrawerAnalyticsPlugin",
        "//Sources/DebugDrawerLeakDetectorPlugin",
    ],
)

# Every global plugin installed with its defaults, for the examples with no SwiftUI root (the UIKit
# and AppKit apps).

swift_library(
    name = "ExamplePlugins",
    srcs = glob(["Plugins/*.swift"]),
    module_name = "ExamplePlugins",
    deps = _SHARED_DEPS,
)

# ── macOS ────────────────────────────────────────────────────────────

swift_library(
    name = "ExampleAppLib_macOS",
    srcs = glob(["macOS/*.swift"]),
    module_name = "ExampleApp_macOS",
    # The interposer's dylib, which macos_application copies into Contents/Frameworks, so
    # unsafeInstallDiskIOWithInterposing() records Swift's Data and FileHandle calls too.
    deps = _SHARED_DEPS + [":ExampleTestBench", "//Sources/DebugDrawerDiskIOInterposer"],
)

macos_application(
    name = "ExampleApp_macOS",
    bundle_id = "com.debugdrawer.example",
    bundle_name = "DebugDrawerExample",
    infoplists = ["macOS/Info.plist"],
    # English and German tables, German missing a few keys, for the Localization plugin.
    resources = glob(["macOS/Resources/**"]),
    minimum_os_version = "15.0",
    entitlements = "macOS/ExampleApp.entitlements",
    deps = [":ExampleAppLib_macOS"],
    linkopts = ["-framework", "IOKit"],
    visibility = ["//visibility:public"],
)

# ── iOS ──────────────────────────────────────────────────────────────

swift_library(
    name = "ExampleAppLib_iOS",
    srcs = glob(["iOS/*.swift"]),
    module_name = "ExampleApp_iOS",
    deps = _SHARED_DEPS + [":ExampleTestBench"],
)

ios_application(
    name = "ExampleApp_iOS",
    bundle_id = "com.debugdrawer.example.ios",
    bundle_name = "DebugDrawerExample",
    families = ["iphone", "ipad"],
    infoplists = ["iOS/Info.plist"],
    # English and German tables, German missing a few keys, for the Localization plugin.
    resources = glob(["iOS/Resources/**"]),
    minimum_os_version = "17.0",
    entitlements = "iOS/ExampleApp_iOS.entitlements",
    frameworks = [":DebugDrawerDiskIOInterposer_iOS"],
    deps = [":ExampleAppLib_iOS"],
    visibility = ["//visibility:public"],
)

# The interposer as a dynamic framework the app embeds and links at launch, so
# unsafeInstallDiskIOWithInterposing() records Swift's Data and FileHandle calls too. ios_application
# doesn't embed a cc_import's dylib, as macos_application does, so iOS wraps the sources itself.
ios_framework(
    name = "DebugDrawerDiskIOInterposer_iOS",
    bundle_id = "com.debugdrawer.example.ios.interposer",
    bundle_name = "DebugDrawerDiskIOInterposer",
    families = ["iphone", "ipad"],
    infoplists = ["iOS/Interposer-Info.plist"],
    minimum_os_version = "17.0",
    deps = ["//Sources/DebugDrawerDiskIOInterposer:DebugDrawerDiskIOInterposerSources"],
)

# ── iOS, UIKit ───────────────────────────────────────────────────────
# A UIKit app with no SwiftUI root: its scene delegate attaches the drawer with attach(to:), and it
# installs every global plugin (ExamplePlugins). The Deep Link Tester has no handler, so an activity
# it sends goes to the scene delegate's scene(_:continue:). Its Test Bench button lists the test
# bench in a table.

swift_library(
    name = "ExampleAppLib_iOSUIKit",
    srcs = glob(["iOSUIKit/*.swift"]),
    module_name = "ExampleApp_iOSUIKit",
    # UIKit alone: `bazel build //...` builds the library only through the app below, for the iOS
    # simulator, and skips it on the Mac.
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":ExamplePlugins",
        ":ExampleTestBench",
        "//Sources/DebugDrawer",
        "//Sources/DebugDrawerNotificationsPlugin",
    ],
)

ios_application(
    name = "ExampleApp_iOSUIKit",
    bundle_id = "com.debugdrawer.example.uikit",
    bundle_name = "DebugDrawerUIKitExample",
    families = ["iphone", "ipad"],
    infoplists = ["iOSUIKit/Info.plist"],
    minimum_os_version = "17.0",
    deps = [":ExampleAppLib_iOSUIKit"],
    visibility = ["//visibility:public"],
)

# ── macOS, AppKit ────────────────────────────────────────────────────
# An AppKit app with no SwiftUI root: its window attaches the drawer with attach(to:), and it
# installs every global plugin (ExamplePlugins), as the UIKit app does. Its Debug menu holds the
# test bench. No source of its own imports SwiftUI, so building it shows an AppKit-only host
# compiles; the macOS example's Debug > Show AppKit Window shows the same inside a SwiftUI app.

swift_library(
    name = "ExampleAppLib_macOSAppKit",
    srcs = glob(["macOSAppKit/*.swift"]),
    module_name = "ExampleApp_macOSAppKit",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":ExamplePlugins",
        ":ExampleTestBench",
        "//Sources/DebugDrawer",
    ],
)

macos_application(
    name = "ExampleApp_macOSAppKit",
    bundle_id = "com.debugdrawer.example.appkit",
    bundle_name = "DebugDrawerAppKitExample",
    infoplists = ["macOSAppKit/Info.plist"],
    minimum_os_version = "15.0",
    entitlements = "macOSAppKit/ExampleAppKit.entitlements",
    deps = [":ExampleAppLib_macOSAppKit"],
    linkopts = ["-framework", "IOKit"],
    visibility = ["//visibility:public"],
)

# ── Sidecar and its production host (iOS, iPadOS and macOS) ──────────
# A company's sidecar app built from DebugDrawerSidecarKit, and a production app serving it through
# DebugDrawerReceiver, for every platform the kit builds on; `just run sidecar` launches the pair in
# the iOS simulator, with the iOS example's debug build beside them, `just run sidecar macOS` on
# the Mac. On iOS all three join group.com.debugdrawer.example, the host and the iOS example each
# serving its own directory of the group's store, so the sidecar lists both; the Mac apps are
# built without a group and signed into a team-prefixed one by the run recipe (Example/SidecarStore
# says why).

# Where the two apps meet: the group's store, or the Mac's fallback folder.
swift_library(
    name = "ExampleSidecarStore",
    srcs = glob(["SidecarStore/*.swift"]),
    module_name = "ExampleSidecarStore",
)

# The sidecar: the kit's view, the example's grant server and a plugin for each capability the
# production host serves.
swift_library(
    name = "ExampleAppLib_Sidecar",
    srcs = glob(["Sidecar/*.swift"]),
    module_name = "ExampleApp_Sidecar",
    deps = [
        ":ExampleSidecarStore",
        "//Sources/DebugDrawer",
        "//Sources/DebugDrawerAccessibility",
        "//Sources/DebugDrawerAnalytics",
        "//Sources/DebugDrawerLocalization",
        "//Sources/DebugDrawerMetricKit",
        "//Sources/DebugDrawerNetwork",
        "//Sources/DebugDrawerNotifications",
        "//Sources/DebugDrawerReceiver",
        "//Sources/DebugDrawerSidecarKit",
        "//Sources/DebugDrawerTweaks",
    ],
)

ios_application(
    name = "ExampleApp_Sidecar_iOS",
    bundle_id = "com.debugdrawer.example.sidecar",
    bundle_name = "DebugDrawerSidecarExample",
    families = ["iphone", "ipad"],
    infoplists = ["Sidecar/Info.plist"],
    minimum_os_version = "17.0",
    entitlements = "Sidecar/Sidecar_iOS.entitlements",
    deps = [":ExampleAppLib_Sidecar"],
    visibility = ["//visibility:public"],
)

macos_application(
    name = "ExampleApp_Sidecar_macOS",
    bundle_id = "com.debugdrawer.example.sidecar",
    bundle_name = "DebugDrawerSidecarExample",
    infoplists = ["Sidecar/Info.plist"],
    minimum_os_version = "15.0",
    deps = [":ExampleAppLib_Sidecar"],
    visibility = ["//visibility:public"],
)

# A production app's use of DebugDrawer: the release-safe receiver and the capability modules,
# nothing else, serving a sidecar every capability the library ships, within sessions that need a
# grant. `just release-check` builds it optimized, and its binary holds no drawer, plugin or
# interception code (README, "Production builds: the receiver").
swift_library(
    name = "ExampleAppLib_Receiver",
    srcs = glob(["Receiver/*.swift"]),
    module_name = "ExampleApp_Receiver",
    deps = [
        ":ExampleSidecarStore",
        "//Sources/DebugDrawerAccessibility",
        "//Sources/DebugDrawerAnalytics",
        "//Sources/DebugDrawerAppInfo",
        "//Sources/DebugDrawerAppStateReset",
        "//Sources/DebugDrawerHangDetector",
        "//Sources/DebugDrawerLocalization",
        "//Sources/DebugDrawerMetricKit",
        "//Sources/DebugDrawerNetwork",
        "//Sources/DebugDrawerNotifications",
        "//Sources/DebugDrawerReceiver",
        "//Sources/DebugDrawerTweaks",
    ],
)

ios_application(
    name = "ExampleApp_Receiver_iOS",
    bundle_id = "com.debugdrawer.example.receiver",
    bundle_name = "DebugDrawerReceiverExample",
    families = ["iphone", "ipad"],
    infoplists = ["Receiver/Info.plist"],
    minimum_os_version = "17.0",
    entitlements = "Receiver/Receiver_iOS.entitlements",
    deps = [":ExampleAppLib_Receiver"],
    visibility = ["//visibility:public"],
)

macos_application(
    name = "ExampleApp_Receiver_macOS",
    bundle_id = "com.debugdrawer.example.receiver",
    bundle_name = "DebugDrawerReceiverExample",
    infoplists = ["Receiver/Info.plist"],
    minimum_os_version = "15.0",
    deps = [":ExampleAppLib_Receiver"],
    visibility = ["//visibility:public"],
)

