# Protanopia, deuteranopia, tritanopia and grayscale simulated live over the views marked debugColorVision(), with a color-matrix shader in linear RGB, picked in the drawer or cycled from the HUD, so meaning carried only by color shows.
swift_library(
    name = "DebugDrawerColorVisionPlugin",
    srcs = glob(["**/*.swift"]),
    module_name = "DebugDrawerColorVisionPlugin",
    deps = [
        "//Sources/DebugDrawer",
    ],
    visibility = ["//visibility:public"],
)

# The module's DocC archive, merged into //:docs. `manual` keeps it out of `bazel build //...`.
docc_archive(
    name = "DebugDrawerColorVisionPluginDocumentation",
    module = ":DebugDrawerColorVisionPlugin",
    catalog = glob(["*.docc/**"], allow_empty = True),
    deps = [
        "//Sources/DebugDrawer:DebugDrawerDocumentation",
    ],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The module's Metal sources and the Swift files tools/metallibs.py compiles them into, which
