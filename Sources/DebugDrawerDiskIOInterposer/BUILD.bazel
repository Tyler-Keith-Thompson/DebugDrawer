# GENERATED by scripts/modules.py — edit DYNAMIC_LIBRARIES there, then run `just modules`.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The Disk I/O plugin's opt-in interposer: dyld interposing tuples for read, write, pread and pwrite, inert until unsafeInstallDiskIOWithInterposing() starts them.
# A dynamic library (DYNAMIC_LIBRARIES in scripts/modules.py): its C sources, compiled with DEBUG
# in debug builds only.
cc_library(
    name = "DebugDrawerDiskIOInterposerSources",
    srcs = glob(["*.c"]),
    hdrs = glob(["include/*.h"]),
    includes = ["include"],
    local_defines = select({"//tools:debug": ["DEBUG=1"], "//conditions:default": []}),
    # Nothing references the library's symbols by name, so the linker would otherwise drop them.
    alwayslink = True,
    # Visible so an app can wrap them in a framework of its own (Example/BUILD.bazel does for iOS).
    visibility = ["//visibility:public"],
)

# The dylib itself, found at launch through the @rpath of whatever links it.
cc_binary(
    name = "libDebugDrawerDiskIOInterposer.dylib",
    linkshared = True,
    linkopts = ["-Wl,-install_name,@rpath/libDebugDrawerDiskIOInterposer.dylib"],
    deps = [":DebugDrawerDiskIOInterposerSources"],
)

# What a test or a macOS app depends on to link the dylib at launch; macos_application copies it
# into Contents/Frameworks.
cc_import(
    name = "DebugDrawerDiskIOInterposer",
    hdrs = glob(["include/*.h"]),
    shared_library = ":libDebugDrawerDiskIOInterposer.dylib",
    visibility = ["//visibility:public"],
)
