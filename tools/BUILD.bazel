# First-party Swift rule wrappers; see swift_rules.bzl.

load("@rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":catalyst.bzl", "catalyst_build_setting")
load(":python_test.bzl", "python_test")
load(":simulator_test_runner.bzl", "simulator_test_runner")

# tools/bazel's daily sweep of stale output bases (tools/sweep-output-bases).
python_test(
    name = "sweep_output_bases_test",
    size = "small",
    src = "sweep_output_bases_test.py",
    data = [
        "bazel",
        "sweep-output-bases",
    ],
)

# The precompiled shaders (tools/metallibs.py) against the Metal sources they were compiled from.
python_test(
    name = "metallibs_test",
    size = "small",
    src = "metallibs_test.py",
    data = [
        "//Sources/DebugDrawerColorVisionPlugin:shaders",
    ],
)

# Runs the iOS test bundles (TESTED_PLATFORMS in scripts/modules.py), hosted by //tools/test_host,
# through xcodebuild in a new simulator that is deleted afterwards. An ios_xctestrun_runner of
# its own, rather than the default, for that simulator and its deletion.
ios_xctestrun_runner(
    name = "ios_test_runner",
    create_simulator_action = ":create_simulator",
    # An iPad, where a form sheet leaves the screen around it uncovered (the View Inspector's
    # covered-outline tests); the other tests size their own views.
    device_type = "iPad Pro 13-inch (M5)",
    reuse_simulator = False,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "create_simulator",
    srcs = ["create_simulator.sh"],
)

# Run the visionOS, tvOS and watchOS test bundles (TESTED_PLATFORMS in scripts/modules.py), each in
# a new simulator.
simulator_test_runner(
    name = "visionos_test_runner",
    platform_name = "visionOS",
    runtime_platform = "xrOS",
    simulator_platform = "XRSimulator",
    visibility = ["//visibility:public"],
)

simulator_test_runner(
    name = "tvos_test_runner",
    platform_name = "tvOS",
    runtime_platform = "tvOS",
    simulator_platform = "AppleTVSimulator",
    visibility = ["//visibility:public"],
)

simulator_test_runner(
    name = "watchos_test_runner",
    platform_name = "watchOS",
    runtime_platform = "watchOS",
    simulator_platform = "WatchSimulator",
    visibility = ["//visibility:public"],
)

# Mac Catalyst (tools/catalyst.bzl): true where catalyst_build_test and catalyst_test build their
# targets. Not a flag to set by hand: only their transition gives it the Catalyst target triple.
catalyst_build_setting(
    name = "catalyst_build",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# A `select` key for code built for Mac Catalyst. It names macOS too, so where both match it wins
# over `@platforms//os:macos`: a Catalyst build is a macOS configuration.
config_setting(
    name = "catalyst",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {":catalyst_build": "True"},
    visibility = ["//visibility:public"],
)

# Source locations for the DocC rules (tools/docc.bzl), wherever a module's compile ran.
exports_files(["docc_symbol_graph.py"])

python_test(
    name = "docc_symbol_graph_test",
    size = "small",
    src = "docc_symbol_graph_test.py",
    data = ["docc_symbol_graph.py"],
)

# Debug builds (the default; `--config=release` builds opt). Modules that generate mocks define
# MOCKING only under this setting (MOCKING in scripts/modules.py).
config_setting(
    name = "debug",
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

# docc_archive's check that every public symbol is documented (tools/docc.bzl), and its tests.
exports_files(
    ["documentation_coverage.py"],
    visibility = ["//visibility:public"],
)

python_test(
    name = "documentation_coverage_test",
    size = "small",
    src = "documentation_coverage_test.py",
    data = ["documentation_coverage.py"],
)

# The Info.plist of a module's resource bundle on Apple platforms (RESOURCES in scripts/modules.py,
# tools/resources.bzl): the keys SwiftPM writes into the bundle it builds for the same resources.
exports_files(["ResourceBundleInfo.plist"])
