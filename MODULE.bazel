module(
    name = "debugdrawer",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.0.0")

# apple_support must come BEFORE rules_cc for toolchain resolution.
bazel_dep(name = "apple_support", version = "2.10.1", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_swift", version = "4.3.0")
# 5.2.0 or later: before it, the xctestrun runner (iOS tests' default from 5.0.0) copied
# XCUnit.framework, which Xcode 27.2 no longer ships, into a UI test's runner app, so every UI test
# on it failed before it ran.
bazel_dep(name = "rules_apple", version = "5.4.0")

# rules_swift reads the modules of the macOS and iOS SDKs alone unless the root module names more;
# the tvOS, visionOS and watchOS builds (EXTRA_PLATFORMS and TESTED_PLATFORMS in scripts/modules.py,
# the example apps) fail analysis without theirs (all_modules "doesn't match this configuration").
system_sdk = use_extension("@rules_swift//swift:extensions.bzl", "system_sdk")
system_sdk.configure_sdks(names = ["AppleTVOS", "AppleTVSimulator", "WatchOS", "WatchSimulator", "XROS", "XRSimulator"])

# sh_binary, for //tools:create_simulator (the iOS test runner's simulator) and the UI tests' runner
# (tools/ui_test).
bazel_dep(name = "rules_shell", version = "0.8.0")

# ── Xcode project generation ─────────────────────────────────────────
# Bazel is the build system, but the package still has to be workable in Xcode (debugger,
# test navigator, Instruments). `just generate` builds a project from the Bazel graph, so the
# two cannot drift.
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

# ── Swift Package Manager dependencies ───────────────────────────────
# Declared in //swift:Package.swift, a manifest that exists only to feed Bazel. The root
# Package.swift stays the published package definition; scripts/modules.py writes both from one
# table (PACKAGES), so they name the same packages. Run `just resolve` after changing them.
bazel_dep(name = "rules_swift_package_manager", version = "1.26.0")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    declare_swift_deps_info = True,
    resolved = "//swift:Package.resolved",
    swift = "//swift:Package.swift",
)
# One `swiftpkg_<identity>` entry per package in PACKAGES, hyphens as underscores.
use_repo(
    swift_deps,
    "swift_deps_info",
    "swift_package",
    "swiftpkg_oslogclient",
    "swiftpkg_swift_snapshot_testing",
    "swiftpkg_viewinspector",
    "swiftpkg_xctest_dynamic_overlay",
)

# ── Lint ─────────────────────────────────────────────────────────────
# `just lint` (tools/lint.bzl): SwiftLint on every first-party target, and a11y-check, which reads
# SwiftUI code for accessibility mistakes, on every non-test one.
bazel_dep(name = "swiftlint", version = "0.65.1", repo_name = "SwiftLint")
bazel_dep(name = "swift-syntax", version = "603.0.2")
bazel_dep(name = "swift_argument_parser", version = "1.7.1")
bazel_dep(name = "yams", version = "6.2.2")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "a11y_check",
    build_file = "//third_party:a11y_check.BUILD.bazel",
    sha256 = "2b100686ea6d0488599d2b887b13e91b8eb49bb9d2845a6e10856631367c2570",
    strip_prefix = "ios-swiftui-accessibility-techniques-0.7.0/a11y-check",
    urls = ["https://github.com/cvs-health/ios-swiftui-accessibility-techniques/archive/refs/tags/0.7.0.tar.gz"],
)
