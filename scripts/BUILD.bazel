# The repository's scripts. scripts/modules.py writes no file here.

load("//tools:python_test.bzl", "python_test")

# The gates `just deploy` passes before tagging (scripts/release.py).
python_test(
    name = "release_test",
    size = "small",
    src = "release_test.py",
    data = ["release.py"],
)

# The check that every public symbol exists in release builds (scripts/release_api.py).
python_test(
    name = "release_api_test",
    size = "small",
    src = "release_api_test.py",
    data = ["release_api.py"],
)

# How the Mac Catalyst example's package is derived from Example's sources
# (scripts/catalyst_example.py, which `just spm-catalyst-example` and `just run catalyst` run).
python_test(
    name = "catalyst_example_test",
    size = "small",
    src = "catalyst_example_test.py",
    data = ["catalyst_example.py"],
)

# The simulator `just test-ios` runs on, one per checkout (scripts/ios_simulator.py).
python_test(
    name = "ios_simulator_test",
    size = "small",
    src = "ios_simulator_test.py",
    data = ["ios_simulator.py"],
)

# The identity `just run macOS` signs the Mac example with, so its privacy grants survive a rebuild
# (scripts/sign_example.py).
python_test(
    name = "sign_example_test",
    size = "small",
    src = "sign_example_test.py",
    data = ["sign_example.py"],
)

# What SKIP_TESTS leaves out of every SwiftPM test run, in each runner's form (scripts/test_skips.py,
# which just spm-test's stages and just test-ios run). It reads the test targets from modules.py.
python_test(
    name = "test_skips_test",
    size = "small",
    src = "test_skips_test.py",
    data = [
        "modules.py",
        "test_skips.py",
    ],
)

# The module graph's check that no two snapshot references of one test target share a base name
# (scripts/modules.py, which `just modules` and `just record-snapshots` run).
python_test(
    name = "modules_test",
    size = "small",
    src = "modules_test.py",
    data = ["modules.py"],
)
