# GENERATED by scripts/modules.py — edit the table there, then run `just modules`.

load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_apple//apple:visionos.bzl", "visionos_unit_test")
load("//tools:swift_rules.bzl", "swift_library", "swift_test")

# The tests, built once and linked into two runners.
# Tagged `debug-only`: none of these relies on speed, so
# `--config=release` neither builds nor runs them (.bazelrc).
swift_library(
    name = "DebugDrawerTestsLibrary",
    testonly = True,
    # Tests are found through metadata the linker would otherwise drop, since nothing
    # references them by name.
    alwayslink = True,
    srcs = glob(["**/*.swift"]),
    data = glob(["__Snapshots__/**"], allow_empty = True),
    module_name = "DebugDrawerTests",
    tags = ["debug-only"],
    # Read by //:package_swift_test, which checks Package.swift against the Bazel graph.
    visibility = ["//:__pkg__"],
    deps = [
        "//Sources/DebugDrawer",
        "//Sources/DebugDrawerReceiver",
    ] + select({
        # Apple-only packages (APPLE_ONLY_PACKAGES in scripts/modules.py).
        "@platforms//os:macos": [
            "@swiftpkg_viewinspector//:ViewInspector",
            "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
            "@swiftpkg_xctest_dynamic_overlay//:IssueReportingTestSupport",
        ],
        "@platforms//os:visionos": [
            "@swiftpkg_xctest_dynamic_overlay//:IssueReportingTestSupport",
        ],
        "//conditions:default": [],
    }),
)

# `bazel test` / `just test`: a standalone executable, fast to start and run in Bazel's sandbox.
swift_test(
    name = "DebugDrawerTests",
    size = "small",
    tags = ["debug-only"],
    deps = [":DebugDrawerTestsLibrary"],
)

# The generated Xcode project: a real .xctest bundle (an MH_BUNDLE), which is what Xcode's test
# runner loads. `manual` keeps it out of `bazel test //...`; it runs through xcodebuild, so it
# is only for Xcode. XCTest refuses exit tests in a sandboxed host, hence `no-sandbox`.
macos_unit_test(
    name = "DebugDrawerTestsBundle",
    bundle_name = "DebugDrawerTests",
    size = "small",
    minimum_os_version = "15.0",
    tags = ["manual", "no-sandbox"],
    # Visible so `//:xcodeproj` can name it as a top-level target.
    visibility = ["//visibility:public"],
    deps = [":DebugDrawerTestsLibrary"],
)

# `bazel test` / `just test` on visionOS: the bundle, run in a new visionOS simulator by
# //tools:visionos_test_runner (TESTED_PLATFORMS in scripts/modules.py). Booting one takes
# much of a minute on its own.
visionos_unit_test(
    name = "DebugDrawerTests_visionOS",
    size = "medium",
    minimum_os_version = "1.0",
    runner = "//tools:visionos_test_runner",
    tags = ["debug-only"],
    deps = [":DebugDrawerTestsLibrary"],
)
