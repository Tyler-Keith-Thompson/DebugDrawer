# The tests, built once and linked into two runners.
# Tagged `debug-only`: none of these relies on speed, so
# `--config=release` neither builds nor runs them (.bazelrc).
swift_library(
    name = "DebugDrawerSidecarKitTestsLibrary",
    testonly = True,
    # Tests are found through metadata the linker would otherwise drop, since nothing
    # references them by name.
    alwayslink = True,
    srcs = glob(["**/*.swift"]),
    module_name = "DebugDrawerSidecarKitTests",
    tags = ["debug-only"],
    # Read by //:package_swift_test, which checks Package.swift against the Bazel graph.
    visibility = ["//:__pkg__"],
    deps = [
        "//Sources/DebugDrawerSidecarKit",
        "//Sources/DebugDrawer",
        "//Sources/DebugDrawerReceiver",
        "//Sources/DebugDrawerAppInfo",
        "//Sources/DebugDrawerLocation",
        "//Sources/DebugDrawerAppStateReset",
        "//Sources/DebugDrawerTweaks",
        "//Sources/DebugDrawerAnalytics",
        "//Sources/DebugDrawerLocalization",
        "//Sources/DebugDrawerAccessibility",
        "//Tests/DebugDrawerTestSupport",
    ] + select({
        # Linked where they build (PLATFORM_CONDITIONAL_DEPENDENCIES in scripts/modules.py).
        "@platforms//os:macos": [
            "//Sources/DebugDrawerHangDetectorPlugin",
            "//Sources/DebugDrawerNetworkPlugin",
            "//Sources/DebugDrawerConsolePlugin",
            "//Sources/DebugDrawerMetricKit",
            "//Sources/DebugDrawerNetwork",
            "//Sources/DebugDrawerNotifications",
        ],
        "@platforms//os:ios": [
            "//Sources/DebugDrawerHangDetectorPlugin",
            "//Sources/DebugDrawerNetworkPlugin",
            "//Sources/DebugDrawerConsolePlugin",
            "//Sources/DebugDrawerMetricKit",
            "//Sources/DebugDrawerNetwork",
            "//Sources/DebugDrawerNotifications",
        ],
        "//conditions:default": [],
    }) + select({
        # Apple-only packages (APPLE_ONLY_PACKAGES in scripts/modules.py).
        "@platforms//os:macos": [
            "@swiftpkg_viewinspector//:ViewInspector",
        ],
        "@platforms//os:watchos": [
            "@swiftpkg_viewinspector//:ViewInspector",
        ],
        "//conditions:default": [],
    }),
)

# `bazel test` / `just test`: a standalone executable, fast to start and run in Bazel's sandbox.
swift_test(
    name = "DebugDrawerSidecarKitTests",
    size = "small",
    tags = ["debug-only"],
    deps = [":DebugDrawerSidecarKitTestsLibrary"],
)

# The generated Xcode project: a real .xctest bundle (an MH_BUNDLE), which is what Xcode's test
# runner loads. `manual` keeps it out of `bazel test //...`; it runs through xcodebuild, so it
# is only for Xcode. XCTest refuses exit tests in a sandboxed host, hence `no-sandbox`.
macos_unit_test(
    name = "DebugDrawerSidecarKitTestsBundle",
    bundle_name = "DebugDrawerSidecarKitTests",
    size = "small",
    minimum_os_version = "15.0",
    tags = ["manual", "no-sandbox"],
    # Visible so `//:xcodeproj` can name it as a top-level target.
    visibility = ["//visibility:public"],
    deps = [":DebugDrawerSidecarKitTestsLibrary"],
)

# `bazel test` / `just test` on watchOS: the bundle, run in a new watchOS simulator by
# //tools:watchos_test_runner (TESTED_PLATFORMS in scripts/modules.py). Booting one takes
# much of a minute on its own; `resources:simulator:1` runs one simulator test at a time.
watchos_unit_test(
    name = "DebugDrawerSidecarKitTests_watchOS",
    size = "medium",
    minimum_os_version = "10.0",
    runner = "//tools:watchos_test_runner",
    tags = ["debug-only", "resources:simulator:1"],
    deps = [":DebugDrawerSidecarKitTestsLibrary"],
)
